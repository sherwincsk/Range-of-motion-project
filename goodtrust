void loop() {
    //unsigned long t0 = micros();
// ... one full loop iteration ...
    //Accelerometer
    aY = myIMU.readFloatAccelX();
    aZ = myIMU.readFloatAccelZ();
    //to make arc cos get 90 degrees instead of nan 
    if(aY>=1){
      aY= 0.99999;
    }
    else if(aY<=-1){
      aY= -0.99999;
    }
    //accelerometer angle
    accelPitch = (acos(aY/-1)*180/3.141-90);

    //Gyroscope
    gyroY = myIMU.readFloatGyroY();
    gyroZ = myIMU.readFloatGyroZ();

    //Magnotometer

    // calc angle for final y angle
    finalAnswer = (0.98*(finalAnswer + gyroY *dt) + 0.02*accelPitch);

    
    if (finalAnswer > highYAngle){
      highYAngle = finalAnswer;
    }
    else if (finalAnswer < lowYAngle){
      lowYAngle = finalAnswer;
    }
