// AK09911C Magnetometer Test - XIAO nRF52840 Sense
// Wiring: VCC->3V3, GND->GND, SDA->D4, SCL->D5

#include <Wire.h>

// AK09911 registers
#define REG_WIA1  0x00   // company ID, should be 0x48
#define REG_WIA2  0x01   // device ID, should be 0x05
#define REG_ST1   0x10   // status 1 (data ready)
#define REG_HXL   0x11   // X/Y/Z data start
#define REG_ST2   0x18   // status 2 (overflow)
#define REG_CNTL2 0x31   // mode control
#define REG_CNTL3 0x32   // reset
#define REG_ASAX  0x60   // sensitivity adjustment values

#define MODE_POWERDOWN 0x00
#define MODE_CONT_50HZ 0x06
#define MODE_FUSE_ROM  0x1F

const float UT_PER_LSB = 0.6;   // microtesla per count

byte akAddr = 0;
float adjX = 1, adjY = 1, adjZ = 1;

void writeReg(byte reg, byte val) {
  Wire.beginTransmission(akAddr);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

byte readReg(byte reg) {
  Wire.beginTransmission(akAddr);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(akAddr, (byte)1);
  if (Wire.available()) return Wire.read();
  return 0xFF;
}

void readRegs(byte reg, byte *buf, byte len) {
  Wire.beginTransmission(akAddr);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(akAddr, len);
  for (byte i = 0; i < len && Wire.available(); i++) {
    buf[i] = Wire.read();
  }
}

bool findSensor() {
  // AK09911 address can be 0x0C to 0x0F depending on board wiring
  for (byte a = 0x0C; a <= 0x0F; a++) {
    akAddr = a;
    if (readReg(REG_WIA1) == 0x48 && readReg(REG_WIA2) == 0x05) {
      return true;
    }
  }
  return false;
}

void setup() {
  Serial.begin(115200);
  unsigned long t0 = millis();
  while (!Serial && millis() - t0 < 3000);
  Wire.begin();

  Serial.println("AK09911C test");

  if (!findSensor()) {
    Serial.println("AK09911 NOT found! Check wiring (3V3, GND, SDA=D4, SCL=D5).");
    while (1);
  }

  Serial.print("AK09911 found at address 0x");
  Serial.println(akAddr, HEX);

  // Soft reset
  writeReg(REG_CNTL3, 0x01);
  delay(10);

  // Read factory sensitivity adjustment values
  writeReg(REG_CNTL2, MODE_FUSE_ROM);
  delay(10);
  byte asa[3];
  readRegs(REG_ASAX, asa, 3);
  adjX = (asa[0] - 128) / 128.0 + 1;
  adjY = (asa[1] - 128) / 128.0 + 1;
  adjZ = (asa[2] - 128) / 128.0 + 1;
  writeReg(REG_CNTL2, MODE_POWERDOWN);
  delay(10);

  // Start continuous measurement at 50 Hz
  writeReg(REG_CNTL2, MODE_CONT_50HZ);
  delay(10);

  Serial.println("Reading... rotate the sensor or bring a magnet close.");
}

void loop() {
  // Wait for new data
  if (!(readReg(REG_ST1) & 0x01)) return;

  byte d[8];   // HXL HXH HYL HYH HZL HZH TMPS ST2
  readRegs(REG_HXL, d, 8);   // reading ST2 (last byte) is required

  if (d[7] & 0x08) {
    Serial.println("Overflow - magnetic field too strong (magnet too close?)");
    delay(200);
    return;
  }

  int16_t rawX = (int16_t)((d[1] << 8) | d[0]);
  int16_t rawY = (int16_t)((d[3] << 8) | d[2]);
  int16_t rawZ = (int16_t)((d[5] << 8) | d[4]);

  float x = rawX * adjX * UT_PER_LSB;
  float y = rawY * adjY * UT_PER_LSB;
  float z = rawZ * adjZ * UT_PER_LSB;

  float strength = sqrt(x * x + y * y + z * z);
  float heading = atan2(y, x) * RAD_TO_DEG;
  if (heading < 0) heading += 360;

  Serial.print("X:");   Serial.print(x, 1);
  Serial.print(" Y:");  Serial.print(y, 1);
  Serial.print(" Z:");  Serial.print(z, 1);
  Serial.print(" uT  |  strength:"); Serial.print(strength, 1);
  Serial.print(" uT  heading:");     Serial.println(heading, 0);

  delay(200);
}